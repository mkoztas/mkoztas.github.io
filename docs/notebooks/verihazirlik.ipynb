   "source": [
    "# Hidroklimatolojik Verilerin Hazırlanması ve Kalite Kontrolü (QA/QC)\n",
    "\n",
    "Bu çalışma defteri, Meteoroloji Genel Müdürlüğü'nden (MGM) temin edilen **standart süreli maksimum yağış (`.xlsx`)** ile **günlük sıcaklık ve toplam yağış (`.txt`)** zaman serilerinin **WMO-No. 100 / 1203** standartlarına göre kalite kontrolünü gerçekleştirir.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import io\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from google.colab import files\n",
    "from IPython.display import display, Markdown\n",
    "\n",
    "def colab_dogrudan_yukle(asama_basligi, beklenen_format, ornek_icerik, uzanti):\n",
    "    display(Markdown(f\"### {asama_basligi}\"))\n",
    "    print(f\"Beklenen Dosya : {beklenen_format}\")\n",
    "    print(f\"Beklenen İçerik:\\n{ornek_icerik}\")\n",
    "    print(f\"\\n👇 Aşağıdaki 'Dosya Seç' butonuna tıklayarak {uzanti} dosyanızı seçin (Atlamak için 'İptal'e basın):\")\n",
    "    \n",
    "    try:\n",
    "        yuklenen = files.upload()\n",
    "    except Exception as e:\n",
    "        print(f\"Yükleme iptal edildi veya hata oluştu: {e}\")\n",
    "        return None, None\n",
    "        \n",
    "    if not yuklenen:\n",
    "        print(\"→ Dosya seçilmedi, bu aşama atlandı.\\n\")\n",
    "        return None, None\n",
    "        \n",
    "    dosya_adi = list(yuklenen.keys())[0]\n",
    "    if not dosya_adi.lower().endswith(uzanti):\n",
    "        print(f\"HATA: Beklenen uzantı '{uzanti}', ancak '{dosya_adi}' yüklendi.\\n\")\n",
    "        return None, None\n",
    "        \n",
    "    print(f\"✓ Dosya başarıyla yüklendi: {dosya_adi}\\n\")\n",
    "    return dosya_adi, io.BytesIO(yuklenen[dosya_adi])\n",
    "\n",
    "print(\"✓ Kütüphaneler ve Colab yükleme modülü hazır! Şimdi 2. hücreyi çalıştırabilirsiniz.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "SURELER = ['5dk', '10dk', '15dk', '30dk', '1sa', '2sa', '3sa', '4sa', '5sa', '6sa', '8sa', '12sa', '18sa', '24sa']\n",
    "\n",
    "dosya_adi, dosya_icerik = colab_dogrudan_yukle(\n",
    "    asama_basligi=\"1. Aşama: Standart Süreli Maksimum Yağış QA/QC (.xlsx)\",\n",
    "    beklenen_format=\"MGM Standart Süreli Yağış Tablosu (.xlsx)\",\n",
    "    ornek_icerik=\"- Sayfa Adı: 'TABLO'\\n- 2. Satır (A2): İstasyon Adı\\n- 6. Satırdan itibaren: Gözlem Yılı | 5dk | 10dk | ... | 24sa (mm)\",\n",
    "    uzanti=\".xlsx\"\n",
    ")\n",
    "\n",
    "if dosya_icerik:\n",
    "    df_ham = pd.read_excel(dosya_icerik, sheet_name='TABLO', header=None)\n",
    "    istasyon = str(df_ham.iloc[1, 0]).replace('METEOROLOJİ İSTASYONU', '').strip()\n",
    "    \n",
    "    satirlar = []\n",
    "    for idx in range(5, len(df_ham)):\n",
    "        try:\n",
    "            yil = int(float(df_ham.iloc[idx, 0]))\n",
    "            if 1900 <= yil <= 2030:\n",
    "                satirlar.append([yil] + list(pd.to_numeric(df_ham.iloc[idx, 1:15], errors='coerce').values))\n",
    "        except (ValueError, TypeError):\n",
    "            break\n",
    "            \n",
    "    df_standart = pd.DataFrame(satirlar, columns=['Yil'] + SURELER).sort_values('Yil').reset_index(drop=True)\n",
    "    baslangic, bitis = df_standart['Yil'].min(), df_standart['Yil'].max()\n",
    "    eksik_oran = ((bitis - baslangic + 1 - len(df_standart)) / (bitis - baslangic + 1)) * 100\n",
    "    negatif_hata = int((df_standart[SURELER] < 0).sum().sum())\n",
    "    monotonluk_hatasi = sum(1 for _, r in df_standart.iterrows() if np.any(np.diff(r[SURELER].values) < -1e-6))\n",
    "    \n",
    "    print(f\"İstasyon          : {istasyon} ({baslangic}-{bitis})\")\n",
    "    print(f\"Gözlem Yılı (N)   : {len(df_standart)} | Eksik Oran: %{eksik_oran:.2f}\")\n",
    "    print(f\"Fiziksel Hatalar  : Negatif={negatif_hata}, Monotonluk={monotonluk_hatasi}\")\n",
    "    print(\"WMO Kararı        :\", \"KABUL (Analize Uygun)\" if (len(df_standart) >= 30 and eksik_oran < 10) else \"RED (Yetersiz/Eksik)\")\n",
    "    display(df_standart.head())"
   ]
  },
